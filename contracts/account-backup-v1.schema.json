{
 "$schema":"http://json-schema.org/draft-07/schema#",
 "title":"Private account backup v1 — not a public API DTO",
 "description":"Bounded 4 MiB UTF-8 payload. Runtime validator additionally enforces unique IDs/names/keys, references, real ISO dates, progress UTF-8 bytes/JSON, and time ordering. No sessions allowed.",
 "type":"object","additionalProperties":false,
 "required":["schemaVersion","sessionPolicy","tables"],
 "properties":{
  "schemaVersion":{"const":1},"sessionPolicy":{"const":"reauthenticate"},
  "tables":{"type":"object","additionalProperties":false,"required":["users","recovery_codes","progress","auth_limits"],"properties":{
   "users":{"type":"array","maxItems":10000,"items":{"type":"object","additionalProperties":false,"required":["id","username","display_name","password_hash","password_salt","password_iterations","created_at","last_login_at"],"properties":{
    "id":{"$ref":"#/definitions/id"},"username":{"type":"string","pattern":"^[a-z0-9_]{3,24}$"},
    "display_name":{"type":"string","minLength":1,"maxLength":24},
    "password_hash":{"$ref":"#/definitions/hash"},"password_salt":{"type":"string","pattern":"^[0-9a-f]{32}$"},
    "password_iterations":{"type":"integer","minimum":20000,"maximum":400000},
    "created_at":{"$ref":"#/definitions/date"},"last_login_at":{"anyOf":[{"type":"null"},{"$ref":"#/definitions/date"}]}
   }}},
   "recovery_codes":{"type":"array","maxItems":10000,"items":{"type":"object","additionalProperties":false,"required":["user_id","code_hash"],"properties":{"user_id":{"$ref":"#/definitions/id"},"code_hash":{"$ref":"#/definitions/hash"}}}},
   "progress":{"type":"array","maxItems":40000,"items":{"type":"object","additionalProperties":false,"required":["user_id","scope","payload","self_reported","updated_at"],"properties":{
    "user_id":{"$ref":"#/definitions/id"},"scope":{"enum":["civics","daily","court","game"]},"payload":{"type":"string","minLength":1,"maxLength":8192},"self_reported":{"const":1},"updated_at":{"$ref":"#/definitions/date"}
   }}},
   "auth_limits":{"type":"array","maxItems":100000,"items":{"type":"object","additionalProperties":false,"required":["key","window_start","attempt_count"],"properties":{
    "key":{"type":"string","minLength":1,"maxLength":512},"window_start":{"type":"integer","minimum":0,"maximum":9007199254740991,"multipleOf":300000},"attempt_count":{"type":"integer","minimum":1,"maximum":9007199254740991}
   }}}
  }}
 },
 "definitions":{
  "id":{"type":"string","pattern":"^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"},
  "hash":{"type":"string","pattern":"^[0-9a-f]{64}$"},
  "date":{"type":"string","pattern":"^\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\d\\.\\d{3}Z$"}
 }
}
