{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:eduai:court:v1:state",
  "title": "Court v1 public snapshot, event and event page",
  "$comment": "Structural public DTO contract. Raw-wire validation, UTF-16 limits, identifier uniqueness, actual calendar dates, cross-field identity and evidence visibility are additionally checked by court/protocol.js. This schema must never replace server authorization or the raw parser.",
  "oneOf": [{"$ref":"#/definitions/snapshot"},{"$ref":"#/definitions/event"},{"$ref":"#/definitions/eventPage"}],
  "definitions": {
    "id": {"$ref":"urn:eduai:court:v1:command#/definitions/id"},
    "uuid": {"$ref":"urn:eduai:court:v1:command#/definitions/uuid"},
    "counter": {"type":"integer","minimum":0,"maximum":9007199254740991},
    "timestamp": {"type":"string","pattern":"^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"},
    "action": {
      "type":"object","additionalProperties":false,
      "required":["actionId","label","category","enabled","reasonDisabled","requiredTarget"],
      "properties":{
        "actionId":{"$ref":"#/definitions/id"},
        "label":{"type":"string","minLength":1,"maxLength":160},
        "category":{"enum":["procedure","statement","evidence","objection","assessment","navigation"]},
        "enabled":{"type":"boolean"},
        "reasonDisabled":{"type":"string","maxLength":300},
        "requiredTarget":{"enum":["none","evidence","npc"]}
      }
    },
    "npc": {
      "type":"object","additionalProperties":false,
      "required":["npcId","roleId","displayName","seatId","pose","emotion","speakingState","visible","interactable","requestState"],
      "properties":{
        "npcId":{"$ref":"#/definitions/id"},"roleId":{"$ref":"#/definitions/id"},
        "displayName":{"type":"string","minLength":1,"maxLength":80},"seatId":{"$ref":"#/definitions/id"},
        "pose":{"enum":["idle","speaking","listening","thinking","objecting","presentingEvidence","sitting","standing","turnHeadToSpeaker"]},
        "emotion":{"enum":["neutral","nervous","confident","surprised"]},
        "speakingState":{"enum":["silent","speaking"]},
        "visible":{"type":"boolean"},"interactable":{"type":"boolean"},
        "requestState":{"enum":["idle","pending","failed"]}
      }
    },
    "metadata": {
      "type":"object","additionalProperties":false,"required":["name","value"],
      "properties":{"name":{"type":"string","minLength":1,"maxLength":80},"value":{"type":"string","maxLength":500}}
    },
    "evidence": {
      "type":"object","additionalProperties":false,
      "required":["evidenceId","title","type","text","metadata","sourceRole","admittedStatus","presentationState","factReferences","assetId"],
      "properties":{
        "evidenceId":{"$ref":"#/definitions/id"},"title":{"type":"string","minLength":1,"maxLength":160},
        "type":{"enum":["image","document","chat","timeline","audioTranscript","objectPhoto","mapDiagram","syntheticRecord","cctvStill"]},
        "text":{"type":"string","maxLength":12000},
        "metadata":{"type":"array","maxItems":20,"items":{"$ref":"#/definitions/metadata"}},
        "sourceRole":{"$ref":"#/definitions/id"},"admittedStatus":{"enum":["notConsidered","admitted","excluded"]},
        "presentationState":{"enum":["available","presented"]},
        "factReferences":{"type":"array","maxItems":30,"items":{"$ref":"#/definitions/id"}},
        "assetId":{"anyOf":[{"const":""},{"$ref":"#/definitions/id"}]}
      }
    },
    "state": {
      "type":"object","additionalProperties":false,
      "required":["title","procedure","roleId","stageId","stageLabel","completed","allowedActions","npcs","evidence","feedback"],
      "properties":{
        "title":{"type":"string","minLength":1,"maxLength":160},"procedure":{"enum":["civil","criminal","juvenile"]},
        "roleId":{"$ref":"#/definitions/id"},"stageId":{"$ref":"#/definitions/id"},
        "stageLabel":{"type":"string","minLength":1,"maxLength":160},"completed":{"type":"boolean"},
        "allowedActions":{"type":"array","maxItems":40,"items":{"$ref":"#/definitions/action"}},
        "npcs":{"type":"array","maxItems":30,"items":{"$ref":"#/definitions/npc"}},
        "evidence":{"type":"array","maxItems":40,"items":{"$ref":"#/definitions/evidence"}},
        "feedback":{"type":"string","maxLength":5000}
      }
    },
    "snapshot": {
      "type":"object","additionalProperties":false,
      "required":["apiVersion","requestId","caseId","sessionId","stateVersion","eventId","eventSequence","timestamp","state"],
      "properties":{
        "apiVersion":{"const":1},"requestId":{"$ref":"#/definitions/uuid"},"caseId":{"$ref":"#/definitions/id"},
        "sessionId":{"$ref":"#/definitions/uuid"},"stateVersion":{"$ref":"#/definitions/counter"},
        "eventId":{"$ref":"#/definitions/uuid"},"eventSequence":{"$ref":"#/definitions/counter"},
        "timestamp":{"$ref":"#/definitions/timestamp"},"state":{"$ref":"#/definitions/state"}
      }
    },
    "event": {
      "type":"object","additionalProperties":false,
      "required":["apiVersion","requestId","caseId","sessionId","stateVersion","eventId","eventSequence","timestamp","kind","speaker","roleId","stageId","text","evidenceIds","citationIds","snapshot"],
      "properties":{
        "apiVersion":{"const":1},"requestId":{"$ref":"#/definitions/uuid"},"caseId":{"$ref":"#/definitions/id"},
        "sessionId":{"$ref":"#/definitions/uuid"},"stateVersion":{"$ref":"#/definitions/counter"},
        "eventId":{"$ref":"#/definitions/uuid"},"eventSequence":{"$ref":"#/definitions/counter"},
        "timestamp":{"$ref":"#/definitions/timestamp"},
        "kind":{"enum":["session_started","statement","npc_utterance","evidence_presented","objection","ruling","stage_changed","session_completed","checkpoint"]},
        "speaker":{"type":"string","maxLength":80},"roleId":{"$ref":"#/definitions/id"},"stageId":{"$ref":"#/definitions/id"},
        "text":{"type":"string","maxLength":12000},
        "evidenceIds":{"type":"array","maxItems":40,"items":{"$ref":"#/definitions/id"}},
        "citationIds":{"type":"array","maxItems":30,"items":{"$ref":"#/definitions/id"}},
        "snapshot":{"$ref":"#/definitions/snapshot"}
      }
    },
    "eventPage": {
      "type":"object","additionalProperties":false,"required":["events","nextAfter","currentVersion"],
      "properties":{
        "events":{"type":"array","maxItems":20,"items":{"$ref":"#/definitions/event"}},
        "nextAfter":{"$ref":"#/definitions/counter"},"currentVersion":{"$ref":"#/definitions/counter"}
      }
    }
  }
}
