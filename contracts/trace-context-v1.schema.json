{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:eduai:trace-context:v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "requestId", "traceId"],
  "properties": {
    "schemaVersion": {"const": 1},
    "requestId": {"type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"},
    "traceId": {"type": "string", "pattern": "^[0-9a-f]{32}$", "not": {"const": "00000000000000000000000000000000"}}
  }
}
