{
 "$schema":"http://json-schema.org/draft-07/schema#","$id":"urn:eduai:backup-envelope:v1",
 "description":"Canonical JSON encrypted archive envelope. AES-GCM authenticates metadata as AAD. Schema alone does not prove authenticity, payload validity or restore authorization.",
 "type":"object","additionalProperties":false,"required":["algorithm","metadata","iv","ciphertext"],
 "properties":{
  "algorithm":{"const":"AES-256-GCM"},
  "metadata":{"$ref":"#/definitions/metadata"},
  "iv":{"type":"string","pattern":"^[A-Za-z0-9+/]{16}$"},
  "ciphertext":{"type":"string","minLength":24,"maxLength":5592428,"pattern":"^[A-Za-z0-9+/]+={0,2}$"}
 },
 "definitions":{"metadata":{
  "type":"object","additionalProperties":false,"required":["schemaVersion","archiveId","kind","createdAt","sourceCommit","keyId"],
  "properties":{
   "schemaVersion":{"const":1},"archiveId":{"type":"string","pattern":"^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"},
   "kind":{"enum":["court","accounts","progress","experiments"]},
   "createdAt":{"type":"string","pattern":"^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"},
   "sourceCommit":{"type":"string","pattern":"^[0-9a-f]{40}$"},
   "keyId":{"type":"string","pattern":"^[A-Za-z0-9_-]{1,80}$"}
  }
 }}
}
