{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:eduai:case-graph:v1",
  "type": "object", "additionalProperties": false,
  "required": ["schemaVersion", "facts", "evidence", "witnesses", "timeline", "legalSourceIds"],
  "definitions": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,79}$"},
    "refs": {"type": "array", "maxItems": 64, "uniqueItems": true, "items": {"$ref": "#/definitions/id"}},
    "fact": {
      "type": "object", "additionalProperties": false, "required": ["id"],
      "properties": {"id": {"$ref": "#/definitions/id"}}
    },
    "evidence": {
      "type": "object", "additionalProperties": false, "required": ["id", "factIds"],
      "properties": {"id": {"$ref": "#/definitions/id"}, "factIds": {"$ref": "#/definitions/refs"}}
    },
    "witness": {
      "type": "object", "additionalProperties": false, "required": ["id", "factIds", "evidenceIds"],
      "properties": {"id": {"$ref": "#/definitions/id"}, "factIds": {"$ref": "#/definitions/refs"}, "evidenceIds": {"$ref": "#/definitions/refs"}}
    },
    "event": {
      "type": "object", "additionalProperties": false, "required": ["id", "order", "factIds", "afterIds"],
      "properties": {
        "id": {"$ref": "#/definitions/id"},
        "order": {"type": "integer", "minimum": 0, "maximum": 1000000},
        "factIds": {"$ref": "#/definitions/refs"}, "afterIds": {"$ref": "#/definitions/refs"}
      }
    }
  },
  "properties": {
    "schemaVersion": {"const": 1},
    "facts": {"type": "array", "minItems": 1, "maxItems": 64, "items": {"$ref": "#/definitions/fact"}},
    "evidence": {"type": "array", "maxItems": 32, "items": {"$ref": "#/definitions/evidence"}},
    "witnesses": {"type": "array", "maxItems": 16, "items": {"$ref": "#/definitions/witness"}},
    "timeline": {"type": "array", "maxItems": 64, "items": {"$ref": "#/definitions/event"}},
    "legalSourceIds": {"$ref": "#/definitions/refs"}
  }
}
