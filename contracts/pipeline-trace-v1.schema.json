{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:eduai:pipeline-trace:v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "requestId", "traceId", "event", "spanId", "feature", "step", "timestamp", "latencyMs", "outcome"],
  "properties": {
    "schemaVersion": {"const": 1},
    "requestId": {"$ref": "urn:eduai:trace-context:v1#/properties/requestId"},
    "traceId": {"$ref": "urn:eduai:trace-context:v1#/properties/traceId"},
    "event": {"const": "ai.pipeline.completed"},
    "spanId": {"type": "string", "pattern": "^[0-9a-f]{16}$"},
    "feature": {"enum": ["tutor", "photo", "npc", "stage-dialogue", "case-generation"]},
    "step": {"enum": ["retrieval", "reranker", "validator"]},
    "timestamp": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"},
    "latencyMs": {"type": "integer", "minimum": 0},
    "outcome": {"enum": ["accepted", "rejected", "exception", "unclassified"]}
  }
}
