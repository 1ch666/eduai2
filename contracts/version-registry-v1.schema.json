{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:eduai:registry:v1",
  "type": "object", "additionalProperties": false,
  "required": ["schemaVersion", "entries"],
  "properties": {
    "schemaVersion": {"const": 1},
    "entries": {
      "type": "array", "maxItems": 1000,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["kind", "version", "contentSha256"],
        "properties": {
          "kind": {"enum": ["dataset", "model", "prompt", "embedding", "retrieval", "reranker", "benchmark"]},
          "version": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,79}$"},
          "contentSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    }
  }
}
