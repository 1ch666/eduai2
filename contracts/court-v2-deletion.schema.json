{
 "$schema":"http://json-schema.org/draft-07/schema#",
 "$id":"urn:eduai:court:v2:deletion",
 "$comment":"DELETE /api/v2/court/sessions/{sessionId} accepts the existing v1 mutation shape with actionId=session.delete, empty targetId/text. Only exact retries recover this terminal receipt; a new command after deletion returns 409. No case content is retained.",
 "type":"object","additionalProperties":false,
 "required":["apiVersion","requestId","idempotencyKey","sessionId","eventId","previousVersion","stateVersion","timestamp","outcome"],
 "properties":{
  "apiVersion":{"const":2},
  "requestId":{"$ref":"urn:eduai:court:v1:command#/definitions/mutation/properties/requestId"},
  "idempotencyKey":{"$ref":"urn:eduai:court:v1:command#/definitions/mutation/properties/idempotencyKey"},
  "sessionId":{"$ref":"urn:eduai:court:v1:command#/definitions/mutation/properties/sessionId"},
  "eventId":{"$ref":"urn:eduai:court:v1:command#/definitions/mutation/properties/requestId"},
  "previousVersion":{"type":"integer","minimum":0,"maximum":9007199254740990},
  "stateVersion":{"type":"integer","minimum":1,"maximum":9007199254740991},
  "timestamp":{"type":"string","pattern":"^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"},
  "outcome":{"const":"deleted"}
 }
}
