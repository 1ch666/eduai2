{
 "$schema":"http://json-schema.org/draft-07/schema#",
 "$id":"urn:eduai:court:private-journal:v1",
 "description":"Internal SQL row interchange only. Contains private data. Not a public API or a trusted import format. JSON body state validation and link validation are separate requirements.",
 "type":"object","additionalProperties":false,"required":["schemaVersion","contexts","states"],
 "properties":{
  "schemaVersion":{"const":1},
  "contexts":{"type":"array","items":{"type":"object","additionalProperties":false,"required":["id","body"],"properties":{"id":{"type":"integer","minimum":1,"maximum":9007199254740991},"body":{"type":"string","minLength":2}}}},
  "states":{"type":"array","items":{"type":"object","additionalProperties":false,"required":["version","event_id","context_id","body"],"properties":{
   "version":{"type":"integer","minimum":0,"maximum":9007199254740991},
   "event_id":{"type":"string","pattern":"^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"},
   "context_id":{"type":"integer","minimum":1,"maximum":9007199254740991},"body":{"type":"string","minLength":2}
  }}}
 }
}
