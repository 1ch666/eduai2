{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Provider-account admission status (not provider health or a grant)",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "scope", "checkedAt", "code", "canAttempt", "providerHealth"],
  "properties": {
    "schemaVersion": {"const": 1},
    "scope": {"const": "provider-account"},
    "checkedAt": {"type": "integer", "minimum": 0, "maximum": 8000000000000000},
    "code": {"enum": ["READY", "DISABLED", "CIRCUIT_OPEN", "BUDGET", "QUEUE_FULL", "CAPACITY"]},
    "canAttempt": {"type": "boolean"},
    "providerHealth": {"const": "not-probed"}
  },
  "allOf": [{"if": {"properties": {"code": {"const": "READY"}}}, "then": {"properties": {"canAttempt": {"const": true}}}, "else": {"properties": {"canAttempt": {"const": false}}}}]
}
