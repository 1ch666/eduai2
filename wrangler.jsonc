{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "civic-law-lab-212",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "LEGAL_RAG_ENABLED": "true",
    "LEGAL_CORPUS_VERSION": "law-0b85a6d187c7b6dc",
    "OLLAMA_MODEL": "gpt-oss:20b",
    "AI_ADMISSION_ENABLED": "true"
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/", "/index.html"]
  },
  // Provision and ingest explicitly before enabling; no automatic paid upgrade.
  "ai": { "binding": "LEGAL_AI" },
  "vectorize": [{ "binding": "LEGAL_INDEX", "index_name": "eduai2-law-google-mrl256" }],
  "durable_objects": {
    "bindings": [
      {
        "name": "MESSAGE_ROOM",
        "class_name": "MessageRoom"
      },
      {
        "name": "ACCOUNT_STORE",
        "class_name": "AccountStore"
      },
      {
        "name": "COURT_ROOM",
        "class_name": "CourtRoom"
      },
      {
        "name": "LEARNER",
        "class_name": "Learner"
      },
      {
        "name": "PRACTICE",
        "class_name": "Practice"
      },
      {
        "name": "PLANNER",
        "class_name": "Planner"
      },
      {
        "name": "PUSH_STORE",
        "class_name": "PushStore"
      },
      {
        "name": "RANKINGS",
        "class_name": "Rankings"
      },
      {
        "name": "GROUPS",
        "class_name": "Groups"
      },
      {
        "name": "AI_ADMISSION",
        "class_name": "AIAdmission"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["MessageRoom"]
    },
    {
      "tag": "v2",
      "new_sqlite_classes": ["AccountStore"]
    },
    {
      "tag": "v3",
      "new_sqlite_classes": ["CourtRoom", "Learner"]
    },
    {
      "tag": "v4",
      "new_sqlite_classes": ["Practice"]
    },
    {
      "tag": "v5",
      "new_sqlite_classes": ["Planner"]
    },
    {
      "tag": "v6",
      "new_sqlite_classes": ["PushStore"]
    },
    {
      "tag": "v7",
      "new_sqlite_classes": ["Rankings"]
    },
    {
      "tag": "v8",
      "new_sqlite_classes": ["Groups"]
    },
    {
      "tag": "v9",
      "new_sqlite_classes": ["AIAdmission"]
    }
  ],
  // Every Sunday 16:00 UTC = Monday 00:00 Asia/Taipei — weekly leaderboard reset.
  "triggers": {
    "crons": ["0 16 * * SUN"]
  },
  "observability": {
    "enabled": true,
    "logs": { "head_sampling_rate": 0.1 }
  }
}
